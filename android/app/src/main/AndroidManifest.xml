<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         LINEA PRIVADA TECNOARQUEOLOGiC
         Bloqueador y filtro de llamadas y SMS
         Compatible Android 9 (API 28) -> Android 16 (API 36),
         HyperOS (Xiaomi), EMUI/HarmonyOS (Huawei) y MIUI.
         ============================================================ -->

    <!-- Permisos Críticos para Control de Llamadas y Filtro -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Permisos de Agenda de Contactos -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Permisos de Mensajes SMS -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Notificaciones, Arranque y Servicio en Primer Plano -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />

    <!-- Red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Linea Privada"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <!-- Activity principal Flutter -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Receptor Nativo de Estado Telefónico (Android 9 y anteriores) -->
        <receiver
            android:name=".CallReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Receptor Nativo de Mensajes SMS -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.RECEIVE_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Receptor de Desbloqueo de Pantalla (notificación heads-up) -->
        <receiver
            android:name=".PantallaReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- Receptor de Arranque para reiniciar el filtro tras el reboot -->
        <receiver
            android:name=".ArranqueReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Servicio de Filtrado de Llamadas de Rol de Sistema (Android 10+) -->
        <service
            android:name=".TecnoarqCallService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Servicio de Pantalla de Llamada Propia (rol de teléfono por defecto).
             Permite colgar desconocidos tras 5 tonos de forma nativa y responder/
             rechazar desde la UI de Linea Privada. -->
        <service
            android:name=".InCallServiceImpl"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
        </service>

        <!-- Marcadora mínima: requisito de elegibilidad del rol de teléfono
             por defecto (ACTION_DIAL). -->
        <activity
            android:name=".DialerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Pantalla de llamada en pantalla completa. Sin showWhenLocked, el
             keyguard (teclado numérico) queda al frente al recibir la llamada
             y, al desbloquear, se ve la pantalla de llamada de la app. El
             turnScreenOn enciende la pantalla (el FSI del InCallService la
             despierta sobre el bloqueo). -->
        <activity
            android:name=".PantallaLlamadaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- Servicio en Primer Plano ligero que mantiene vivo el filtro
             desatendido y aplica el tope de 5 tonadas a desconocidos. -->
        <service
            android:name=".FiltroServicio"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <!-- Servicio de Accesibilidad: presiona el botón de colgar/rechazar
             cuando el tope vence, en equipos sin root (permiso MODIFY_PHONE_STATE). -->
        <service
            android:name=".AccesibilidadServicio"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
