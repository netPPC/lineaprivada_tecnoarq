<?xml version="1.0" encoding="utf-8"?>
<!-- Marcador estilo nativo: accesos directos, teclado compacto con imágenes
     personalizadas (tecla_1..tecla_9, tecla_0, tecla_asterisco, tecla_numeral)
     y botones Llamar/Colgar. Durante una llamada activa el teclado envía tonos
     DTMF. Las imágenes provisionales se reemplazan por las definitivas en las
     carpetas drawable-{mdpi,hdpi,xhdpi,xxhdpi,xxxhdpi}. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111">

    <!-- Campo del número (compacto) -->
    <EditText
        android:id="@+id/edit_numero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:inputType="phone"
        android:maxLength="20"
        android:textSize="26sp"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:gravity="center"
        android:background="@null"
        android:cursorVisible="true"
        android:hint="Ingresa número" />

    <!-- Accesos directos: contactos, agregar contacto, perdidas, altavoz -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_contactos"
                style="@style/BotonAcceso"
                android:text="👥" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Contactos"
                android:textColor="#BBBBBB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_agregar_contacto"
                style="@style/BotonAcceso"
                android:text="➕" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Contacto"
                android:textColor="#BBBBBB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_perdidas"
                style="@style/BotonAcceso"
                android:text="🕘" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Perdidas"
                android:textColor="#BBBBBB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_altavoz"
                style="@style/BotonAcceso"
                android:text="🔊" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Altavoz"
                android:textColor="#BBBBBB"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pad numérico con iconos personalizados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <!-- Fila 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_1"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_1" />
            <Button
                android:id="@+id/btn_2"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_2" />
            <Button
                android:id="@+id/btn_3"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_3" />
        </LinearLayout>

        <!-- Fila 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_4"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_4" />
            <Button
                android:id="@+id/btn_5"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_5" />
            <Button
                android:id="@+id/btn_6"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_6" />
        </LinearLayout>

        <!-- Fila 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_7"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_7" />
            <Button
                android:id="@+id/btn_8"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_8" />
            <Button
                android:id="@+id/btn_9"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_9" />
        </LinearLayout>

        <!-- Fila 4: * 0 # -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_asterisco"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_asterisco" />
            <Button
                android:id="@+id/btn_0"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_0" />
            <Button
                android:id="@+id/btn_numeral"
                style="@style/BotonDialerIcono"
                android:background="@drawable/tecla_numeral" />
        </LinearLayout>

        <!-- Fila 5: borrar (redondo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_borrar"
                style="@style/BotonDialer"
                android:text="⌫" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botones inferiores: colgar (rojo) + llamar (verde) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_colgar"
            style="@style/BotonControlColgar"
            android:text="📵" />

        <Button
            android:id="@+id/btn_llamar"
            style="@style/BotonControlLlamar"
            android:text="📞" />
    </LinearLayout>
</LinearLayout>